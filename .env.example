# Copy to .env.local and fill in. Never commit a filled-in env file; the secret check fails the build.
# Everything here is optional: with nothing set, the prototype runs on templates, the local
# safety check, and the booking mock. Set these in Vercel as Project → Settings → Environment Variables.

# --- Model (server only; never exposed to the browser) ---
# For reflect-back lines, the Match headline, the cost summary, the pre-visit summary and the
# second safety check. Leave empty to run with templates and the local safety check only.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# --- Stripe (TEST MODE ONLY) ---
# With both set, Payment would use Stripe; with neither, the deterministic booking mock runs.
# A live key (sk_live_/pk_live_) makes the app refuse to start, on purpose. Use only pk_test_/sk_test_.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Feature flags (NEXT_PUBLIC_*, inlined into the client bundle) ---
# "Your story" AI pre-visit summary. ON by default for the demo; set to 0 to turn off.
NEXT_PUBLIC_FLAG_PREVISIT_SUMMARY=
# "Already started? Sign in" on Start. 1 to turn on (sign-in is not wired yet).
NEXT_PUBLIC_FLAG_SIGN_IN=
# "Add a photo of your card" on Insurance. 1 to turn on.
NEXT_PUBLIC_FLAG_INSURANCE_CARD_PHOTO=

# --- Dev only ---
# Set to 1 to show the internal "Prototype — internal preview" label and the slice-7 demo
# control panel. Never set this in production; patients must never see them.
NEXT_PUBLIC_SHOW_DEV_LABEL=

# Test only: Playwright sets this to replace the model with a stand-in.
AI_MOCK=
