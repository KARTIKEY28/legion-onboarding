# Copy to .env.local and fill in. Never commit a filled-in env file; the secret check fails the build.

# Model for reflect-back lines and the second safety check. Leave empty to run with
# template lines and the local safety check only.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Set to 1 to show the internal "Prototype · slice N of 7" label. Never in production.
NEXT_PUBLIC_SHOW_DEV_LABEL=

# Test only: Playwright sets this to replace the model with a stand-in.
AI_MOCK=
